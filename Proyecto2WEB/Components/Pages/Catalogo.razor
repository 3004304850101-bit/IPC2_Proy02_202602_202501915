@page "/catalogo"
<h1><strong>Catalogo Biblioteca</strong></h1>
<div class="row">
  <div class="col-md-6">
      <p><strong>Consulta el catalogo de la biblioteca</strong></p>
      <p>Ver Categoria</p>
    <div class="container-fluid-right" style="max-width: 650px; max-height: 590px;" >
        <form class="d-flex" role="search">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search"/>
        <button class="btn btn-outline-success" type="submit">Buscar</button>
        <p>&nbsp</p>
        <button class="btn btn-secondary btn-sm" style="width: 170px">Ver Completo</button>
      </form>
    </div>
    <br />
    <div class="overflow-auto border" style="max-width: 650px; max-height: 500px;">
      <img src="yuta.jpg" height: auto;" width=": auto;">
    </div>
    <br />
    <br>
    <p>Ver Libros por Categoria</p>
    <div class="container-fluid-right" style="max-width: 650px; max-height: 590px;" >
        <form class="d-flex" role="search">
        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search"/>
        <button class="btn btn-outline-success" type="submit">Buscar</button>
        <p>&nbsp</p>
        <button class="btn btn-secondary btn-sm" style="width: 170px">Ver Completo</button>
      </form>
    </div>
    <br />
    <div class="overflow-auto border" style="max-width: 650px; max-height: 590px;">
        <img src="arbol.jpg" height: auto;" width=": auto;">
    </div>
     <br />
  </div>
  <div class="col-md-6">
    <br>
    <br>
      <p>Lista Categorias</p>
      <div class="overflow-auto border" style="max-width: 700px; max-height: 560px; min-height: 560px">
        <table class="table-secondary table fixed">
                  <thead>
            <tr class="table-primary">
              <th scope="col">#</th>
              <th scope="col">Categorias</th>
            </tr>
          </thead>
          <tbody>
            <tr class="table-primary">
              <th scope="row">1</th>
              <td>Mark</td>
            </tr>
            <tr class="table-primary">
              <th scope="row">2</th>
              <td>Jacob</td>
            </tr>
            <tr class="table-primary">
              <th scope="row">3</th>
              <td>John</td>
            </tr>
          </tbody>
        </table>
      </div>
      <br />
      <br />
      <p>Lista Libros</p>
      <div class="overflow-auto border" style="max-width: 700px; max-height: 650px; min-height: 650px">
        <table class="table-secondary table fixed">
                  <thead>
            <tr class="table-primary">
              <th scope="col">#</th>
              <th scope="col">ISBN</th>
              <th scope="col">Tíulo</th>
            </tr>
          </thead>
          <tbody>
            <tr class="table-primary">
              <th scope="row">1</th>
              <td>Mark</td>
              <td>Mark</td>
            </tr>
            <tr class="table-primary">
              <th scope="row">2</th>
              <td>Jacob</td>
              <td>Mark</td>
            </tr>
            <tr class="table-primary">
              <th scope="row">3</th>
              <td>John</td>
              <td>Mark</td>
            </tr>
          </tbody>
        </table>
      </div>
  </div>
</div>
